# CLASPTEK Enterprise Environment Variables Specification
#
# ENVIRONMENT TARGETING:
# - Staging / Preview Environments: Configured by default with staging project ref 'dwhjoiebzwnjdpcvcwvs'.
# - Production Environment: Operators must configure their dedicated production project URL
#   (e.g. https://<your-production-ref>.supabase.co). Staging credentials must not be used in Production.
#
# SECURITY ISOLATION INVARIANT:
# - The legacy project 'logaawoigfxnisimfatf' is PERMANENTLY QUARANTINED.
#   Runtime guards will immediately throw and abort any connection attempt to it.
# - This template file is documentation only. Variables must be configured in your
#   hosting provider (e.g. Vercel Dashboard Settings -> Environment Variables) or
#   in a local non-committed .env.local file.

# =============================================================================
# Supabase Database & Auth Configuration
# =============================================================================
# Canonical Backend Credentials (Server-side Only)
# Staging/Preview default shown below. For Production deployments, replace with your
# dedicated production project URL (e.g. SUPABASE_URL=https://<your-production-ref>.supabase.co).
SUPABASE_URL=https://dwhjoiebzwnjdpcvcwvs.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# Server-only Service Role Secret Key (NEVER expose to browser or prefix with VITE_/NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Frontend Framework Compatibility Aliases (Browser-safe Public Keys Only)
# Staging/Preview default shown below. Replace with production URL for Production deployments.
VITE_SUPABASE_URL=https://dwhjoiebzwnjdpcvcwvs.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://dwhjoiebzwnjdpcvcwvs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here

# IMPORTANT:
# - Use ONLY the public anonymous / publishable API key in browser environments.
# - The Supabase Secret Key (SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY) must be used ONLY in server/backend code.
# - NEVER provide the secret key to the browser or use VITE_/NEXT_PUBLIC_ prefixes for it.

# =============================================================================
# WebRTC Selective Forwarding Unit (SFU) Meeting Provider Configuration
# =============================================================================
# Explicit Provider Selection (Allowed values: 'livekit', 'daily', or 'google_meet'; 'mock' in test suites only)
SFU_PROVIDER=livekit

# LiveKit SFU Configuration (when SFU_PROVIDER=livekit)
LIVEKIT_URL=wss://clasptek-meet.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# =============================================================================
# LiveKit Egress Cloud Storage Destination (REQUIRED for Meeting Recordings)
# =============================================================================
# LiveKit Egress requires intermediary cloud storage to write composite video
# recordings prior to archival in Google Drive. Configure ONE provider below:
#
# Option A: AWS S3 (or S3-compatible, e.g. Cloudflare R2 / MinIO)
LIVEKIT_EGRESS_S3_BUCKET=your_s3_recording_bucket_name
LIVEKIT_EGRESS_AWS_KEY=your_aws_access_key_id
LIVEKIT_EGRESS_AWS_SECRET=your_aws_secret_access_key
LIVEKIT_EGRESS_S3_REGION=us-east-1
# LIVEKIT_EGRESS_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Option B: Google Cloud Storage (GCS)
# LIVEKIT_EGRESS_GCS_BUCKET=your_gcs_recording_bucket_name
# LIVEKIT_EGRESS_GCS_CREDENTIALS={"type":"service_account",...}

# Daily.co Configuration (alternative fallback provider when SFU_PROVIDER=daily)
# DAILY_API_KEY=your_daily_api_key_here
# DAILY_DOMAIN=clasptek.daily.co

# =============================================================================
# Google Workspace, Meet & Google Drive OAuth 2.0 Integration (Server-side Only)
# =============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://app.clasptek.org/api/auth/google/callback

# Google Drive Storage Folder IDs:
# GOOGLE_DRIVE_ROOT_FOLDER_ID: Authoritative central root folder used by google-oauth-config.js
# GOOGLE_DRIVE_MEETINGS_FOLDER_ID: Alias used for meeting recording uploads
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id_here
GOOGLE_DRIVE_MEETINGS_FOLDER_ID=your_google_drive_root_folder_id_here

# NOTE ON GOOGLE MEET & RECORDING ARCHITECTURE:
# 1. Google Meet conference creation requires the Google OAuth connection to include
#    the scope: https://www.googleapis.com/auth/calendar.events
# 2. Clasptek platform meeting recordings are captured via LiveKit SFU Egress.
#    Meetings conducted directly in Google Meet are recorded within Google Workspace
#    and are not captured via Clasptek Egress.

# =============================================================================
# Vercel Scheduled Maintenance & Cron Authorization
# =============================================================================
# Secret key used to authorize Vercel Cron jobs (e.g. /api/cron/reconcile-recordings)
# Configured in Vercel project settings; sent by Vercel in the Authorization: Bearer <CRON_SECRET> header
CRON_SECRET=your_cron_shared_secret_here
