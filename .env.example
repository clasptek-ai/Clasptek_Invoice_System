# CLASPTEK Enterprise Production Environment Variables Example
# Configure these in the Vercel Dashboard under Settings -> Environment Variables
# Target Environment: Production, Preview, Development

# Authoritative Supabase Production Project: logaawoigfxnisimfatf
SUPABASE_URL=https://logaawoigfxnisimfatf.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# Server/Backend-only Secret Key (NEVER expose to browser or prefix with VITE_/NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Frontend framework compatibility aliases (Browser Public Keys Only)
VITE_SUPABASE_URL=https://logaawoigfxnisimfatf.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://logaawoigfxnisimfatf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here

# IMPORTANT:
# - Use ONLY the public anonymous / publishable API key in browser environments.
# - The Supabase Secret Key (SUPABASE_SECRET_KEY) must be used ONLY in server/backend code.
# - NEVER provide the secret key to the browser or use VITE_/NEXT_PUBLIC_ prefixes for it.

# =============================================================================
# WebRTC Selective Forwarding Unit (SFU) Meeting Provider Configuration
# =============================================================================
# Explicit Provider Selection (Allowed values: 'livekit' or 'daily'; 'mock' allowed ONLY in test suites)
SFU_PROVIDER=livekit

# LiveKit Configuration (when SFU_PROVIDER=livekit)
LIVEKIT_URL=wss://clasptek-meet.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Daily.co Configuration (when SFU_PROVIDER=daily)
DAILY_API_KEY=your_daily_api_key_here
DAILY_DOMAIN=clasptek.daily.co

# =============================================================================
# Google Drive OAuth 2.0 Integration (Server-side Only)
# =============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://portal.clasptek.org/api/auth/google/callback

