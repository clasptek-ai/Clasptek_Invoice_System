{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/admin/provision-user", "destination": "/api/admin?action=provision-user" },
    { "source": "/api/admin/delete-personnel", "destination": "/api/admin?action=delete-personnel" },
    { "source": "/api/intake/google-forms", "destination": "/api/admin?action=google-forms-intake" },
    { "source": "/api/auth/google/start", "destination": "/api/auth/google/auth?action=start" },
    { "source": "/api/auth/google/status", "destination": "/api/auth/google/auth?action=status" },
    { "source": "/api/auth/google/disconnect", "destination": "/api/auth/google/auth?action=disconnect" },
    { "source": "/api/auth/google/verify-repository", "destination": "/api/auth/google/auth?action=verify-repository" },
    { "source": "/api/meetings/leave", "destination": "/api/meetings/action?action=leave" },
    { "source": "/api/meetings/status", "destination": "/api/meetings/action?action=status" },
    { "source": "/api/meetings/chat", "destination": "/api/meetings/action?action=chat" },
    { "source": "/clasptek_invoice_system.html", "destination": "/index.html" },
    { "source": "/((?!api/|runtime-config\\.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/|^$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/runtime-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
